# ClawdBot Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ClawdBot Configuration
CLAWDBOT_PORT=18789
NODE_ENV=production

# Optional: Claude CLI Token (alternative to API key)
# CLAUDE_CLI_TOKEN=your-claude-cli-token-here

# Optional: Telegram Bot Token (from @BotFather)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Optional: Discord Bot Token (from Discord Developer Portal)
# DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Optional: Brave Search API Key (for web search capabilities)
# BRAVE_API_KEY=your-brave-api-key-here

# Optional: Custom Model Configuration
# CLAWDBOT_MODEL=anthropic/claude-opus-4-5
# CLAWDBOT_MAX_TOKENS=4096
# CLAWDBOT_TEMPERATURE=0.7

# Optional: Logging Configuration
# CLAWDBOT_LOG_LEVEL=info
# CLAWDBOT_VERBOSE=false
